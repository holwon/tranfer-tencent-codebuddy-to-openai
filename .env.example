# ═══════════════════════════════════════════════════════════════
# CodeBuddy Proxy 配置模板
# 复制为 .env 并按需修改。.env.example 会被提交到 git；.env 被 git 忽略。
# ═══════════════════════════════════════════════════════════════

# 调试开关：true = 记录完整请求/响应日志（含 body）；留空/false = 仅摘要日志
DEBUG=false

# 监听端口（默认 8123）
CB_PORT=8123

# 日志目录（相对 proxy.js 所在目录，默认 ./logs）
# 请求写入 requests-YYYY-MM-DD.jsonl，响应 SSE chunk 写入 streams-YYYY-MM-DD.jsonl
LOG_DIR=./logs

# CodeBuddy access token（可选，设置了则代理会自动带上 Authorization 头）
# 如果通过 VS Code chatLanguageModels.json 的 apiKey 传，这里可不填
# CB_TOKEN=ck_xxx
